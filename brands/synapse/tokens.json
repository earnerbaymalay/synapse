{
  "name": "SYNAPSE",
  "subtitle": "llm-neuro-surgeon",
  "tagline": "One Brain. All Models.",
  "toneAnchor": "Surgical precision. Zero friction.",
  "color": {
    "ink": { "950": "#06080b", "900": "#0b0e13", "800": "#12161d", "700": "#171c25", "600": "#1d2330", "500": "#262c37", "400": "#4b5361", "300": "#8b949e", "100": "#d4dae2" },
    "accent": { "900": "#0a3a5c", "700": "#0d5a96", "500": "#1d9bf0", "300": "#5cb2f5", "100": "#c7e6fd", "usage": "the one working UI accent — links, buttons, focus, active states" },
    "gold": { "900": "#5c4813", "700": "#8a6d1f", "500": "#d4af37", "300": "#f0d580", "100": "#fdf3d6", "usage": "signature hero device ONLY (chain/pendant) — never UI chrome, buttons, links, or status" },
    "semantic": { "success": "#3fb950", "warning": "#d29922", "error": "#ff7b72" }
  },
  "type": {
    "display": { "family": "Rubik Mono One", "usage": "wordmark, hero headlines, stat callouts — uppercase, sparing" },
    "ui": { "family": "Inter", "weights": [400, 500, 600, 700, 800], "usage": "all interface text" },
    "mono": { "family": "JetBrains Mono", "weights": [400, 500, 600, 700], "usage": "commands, code, paths, eyebrows, status readouts" }
  },
  "space": { "1": 4, "2": 8, "3": 12, "4": 16, "5": 24, "6": 32, "7": 48, "8": 64, "unit": "px" },
  "grid": { "columns": 12, "maxWidth": 1200, "gutter": 24, "unit": "px" },
  "radius": { "cards": 0, "note": "square corners everywhere except the pendant/chain device — this is deliberate, not an oversight" },
  "cornerMark": { "size": 9, "strokeOpacityIdle": 0.4, "strokeOpacityHover": 1, "color": "accent.500" },
  "motion": {
    "pulseGlow": { "duration": "2-3s", "loop": true, "usage": "active/live indicators" },
    "drift": { "duration": "4-8s", "loop": true, "usage": "idle icons" },
    "sway": { "duration": "4.5s", "loop": true, "usage": "chain & pendant device only" },
    "ekgScroll": { "duration": "3.4s", "loop": true, "easing": "linear", "usage": "vitals monitor" },
    "hoverLift": { "duration": "0.3s", "easing": "ease", "translateY": "-4px to -8px" },
    "stampIn": { "duration": "0.55s", "easing": "spring", "usage": "one-time reveals" }
  },
  "iconography": { "emoji": false, "lineIconStroke": "1.6-1.8px", "adapterBadge": "two-letter monogram, hexagon clip-path, never a third-party logo" },
  "adapters": ["Claude Code / Desktop", "Cursor", "Windsurf", "Gemini CLI", "OpenAI Codex CLI", "Zed", "Cline", "Continue", "Aider", "GitHub Copilot", "OpenCode", "Roo Code", "Antigravity CLI"],
  "cli": { "binary": "synapse", "commands": ["scan", "import [--dry-run]", "project [--dry-run]", "sync [--once|--daemon]", "doctor [--fix]", "snapshot \"<message>\"", "rollback <hash>"] }
}
