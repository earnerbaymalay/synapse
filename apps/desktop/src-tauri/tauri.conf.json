{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SYNAPSE",
  "version": "1.0.0",
  "identifier": "dev.synapse.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "SYNAPSE // Clinical Engine for AI Context",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "dmg", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Universal AI context engine — one Brain, all models in lockstep",
    "longDescription": "Synapse unifies the configuration, memory, and governance of every AI coding tool on your machine into one canonical, git-backed Brain.",
    "linux": {
      "deb": {
        "depends": [
          "libc6 (>= 2.31)",
          "libgtk-3-0 (>= 3.24.0)",
          "libwebkit2gtk-4.1-0 (>= 2.38.0)",
          "libayatana-appindicator3-1"
        ],
        "section": "devel",
        "priority": "optional"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15.0"
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    }
  }
}
